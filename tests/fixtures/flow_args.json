    {"params": {"areas": "list", "focus": "string"}, "args": "a,b races", "error": "the arguments are k=v words"},
    {"params": {"areas": "list", "focus": "string"}, "args": "colour=red", "error": "k one of areas, focus"},
    {"params": {"areas": "list", "focus": "string"}, "args": "focus=\"unclosed", "error": "the arguments"},
