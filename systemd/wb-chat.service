[Unit]
Description=workbench web chat (wb chat serve): reach Claude's /workbench session from the browser
# No start limit: retrying is what brings the chat up when the port is briefly held. A start
# limit gave up for good after five tries (the 0.90 review); the backoff below replaces it.
StartLimitIntervalSec=0

[Service]
# localhost only (#1616): another device reaches it through a tunnel or proxy of the user's own,
# whose name ~/.config/workbench/chat.json's `hosts` adds. `wb setup` links this
# file into ~/.config/systemd/user/, then enables and starts wb-chat (--no-service skips it);
# bin/wb finds the package from its real path, wherever the clone is.
# The user manager's PATH (/usr/local/bin:/usr/bin) has none of your shell's: a Python 3.11+ from
# pyenv, uv or conda, OpenCode in ~/.opencode/bin, probe in ~/.local/bin. So `wb setup` writes the
# PATH and WB_* variables it runs with into wb-chat.service.d/10-wb-setup.conf beside this link
# (#1342, #1343), and runs again to refresh it; `systemctl --user edit wb-chat` (override.conf,
# read after it) wins over it.
ExecStart=%h/.local/bin/wb chat serve
Restart=always
# The delay grows from 10 s to 5 min (systemd 254+; older systemd ignores these two lines and
# retries every 10 s). The chat never exits to be restarted: it re-execs itself in place to load
# new code, so systemd sees no exit (#200).
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=300
# bin/wb's guards (a python3 older than 3.11 on systemd's PATH, native Windows) exit 78
# (EX_CONFIG): a broken install, which no retry fixes, so the unit stops at once (the 2026-11-16
# audit); so does a chat.json whose hosts isn't a list (#534). `systemctl --user restart
# wb-chat` once it's fixed.
RestartPreventExitStatus=78

[Install]
# A user unit stops at the last logout unless the user lingers: loginctl enable-linger $USER
# (wb chat on and wb doctor say so, #351, the audit of 1.4).
WantedBy=default.target
